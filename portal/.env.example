# כל המשתנים כאן הם צד-שרת בלבד. אין אף אחד עם הקידומת NEXT_PUBLIC_, ולכן Next לא שולח אותם לדפדפן.

# monday: תמונת פרופיל > Developers > My access tokens
MONDAY_TOKEN=

# סוד משותף ל-webhook של monday. מופיע בכתובת ה-webhook: /api/webhooks/monday?secret=...
MONDAY_WEBHOOK_SECRET=

# חלק ד': כתובת שירות הסוכן ב-Render (בלי / בסוף), והסוד המשותף שנשלח בכותרת x-portal-secret.
# הפורטל שולח הזמנות חדשות ל-AGENT_URL/portal ושאלות ל-AGENT_URL/ask.
# אם ריק, ההזמנה נשמרת כטיוטה ב-monday, ותיבת השאלות עונה שאין חיבור.
AGENT_URL=
AGENT_SHARED_SECRET=

# מזהי לוחות ועמודות. ברירות המחדל בקוד הן של ה-workspace "מתכת הגליל". צריך לשנות רק אם הלוחות נבנו מחדש.
# MONDAY_CLIENTS_BOARD_ID=5108619489
# MONDAY_ORDERS_BOARD_ID=5108619492
